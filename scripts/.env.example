# dify-memory-mcp configuration
# Copy this file to .env and fill in your values
# Or run `python install.py --api-key dataset-XXX` for automatic configuration

DIFY_API_KEY=dataset-YOUR_API_KEY_HERE
DIFY_DATASET_ID=          # leave empty to auto-detect from API key
DIFY_DOCUMENT_ID=          # leave empty to auto-create
DIFY_PERMANENT_DOCUMENT_ID=  # leave empty to auto-create
DIFY_BASE_URL=https://api.dify.ai/v1
MEMORY_DECAY_DAYS=30
