# mify-memory-mcp configuration (Dify edition)
# Copy this file to .env and fill in your values
# Or run `python setup.py` for automatic configuration

# ── Dify knowledge-base Service API ──────────────────────────────────────────
# Dify and Mify expose the same /datasets API; only the host differs.
DIFY_BASE_URL=http://127.0.0.1/v1
# Legacy alias, honoured when DIFY_BASE_URL is absent:
# MIFY_BASE_URL=https://service.mify.mioffice.cn/api/v1

# Dify knowledge-base API key (Settings → Datasets → API Keys). Format: dataset-...
MIFY_API_KEY=dataset-YOUR_API_KEY_HERE

# IDs created by install.py / setup.py
MIFY_DATASET_ID=your-dataset-id-here
MIFY_DOCUMENT_ID=your-document-id-here
MIFY_PERMANENT_DOCUMENT_ID=your-permanent-document-id-here
MIFY_SESSION_INDEX_DOCUMENT_ID=your-session-index-document-id-here
MIFY_SESSIONS_DATASET_ID=your-sessions-dataset-id-here

# ── Memory behaviour ────────────────────────────────────────────────────────
MEMORY_DECAY_DAYS=30

# ── Retrieval tuning ────────────────────────────────────────────────────────
# Default is hybrid_search + weighted_score, which needs no rerank model
# provider and therefore works on a stock Dify install.
MEMORY_SEARCH_METHOD=hybrid_search
# weighted_score | reranking_model | none
MEMORY_RERANK_MODE=weighted_score
MEMORY_VECTOR_WEIGHT=0.7
MEMORY_KEYWORD_WEIGHT=0.3
# Used by weighted_score: which embedding model Dify should weight with.
# Must match a provider/model already configured in Dify (Ollama + bge-m3 here).
MEMORY_EMBEDDING_PROVIDER=ollama
MEMORY_EMBEDDING_MODEL=bge-m3
# Only used when MEMORY_RERANK_MODE=reranking_model
# MEMORY_RERANK_PROVIDER=
# MEMORY_RERANK_MODEL=

# ── Runtime ─────────────────────────────────────────────────────────────────
MIFY_MEMORY_MCP_IDLE_TIMEOUT_SECONDS=1800
MIFY_MEMORY_ACTOR=unknown
MIFY_MEMORY_AGENT=unknown
MIFY_MEMORY_DEVICE_ID=unknown
MCPORTER_CONFIG=
MIFY_MEMORY_STATE_DIR=
OPENCLAW_SESSIONS_ROOT=
